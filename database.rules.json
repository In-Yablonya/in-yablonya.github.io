{
  "rules": {
    ".read": false,
    ".write": false,

    "links": {
      "$pid": {
        ".read": "auth != null && root.child('passwordOwner').child($pid).val() === auth.uid",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && ((auth.uid === $uid && !root.child('passwordOwner').child($pid).exists()) || root.child('passwordOwner').child($pid).val() === auth.uid)",
          ".validate": "newData.val() === true"
        }
      }
    },

    "passwordOwner": {
      "$pid": {
        ".read": "auth != null && root.child('links').child($pid).child(auth.uid).exists()",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid && root.child('links').child($pid).child(auth.uid).exists() && auth.token.email.endsWith('@accounts.yablonya.invalid')",
        ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 128"
      }
    },

    "uidPid": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('links').child(newData.val()).child($uid).exists())",
        ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 128"
      }
    },

    "meta": {
      "userCounter": {
        ".read": "auth != null",
        ".write": "auth != null && newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)"
      }
    },

    "players": {
      "$pid": {
        ".read": "auth != null && root.child('links').child($pid).child(auth.uid).exists()",
        "createdAt": {
          ".write": "auth != null && root.child('links').child($pid).child(auth.uid).exists()",
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)"
        },
        "number": {
          ".write": "auth != null && root.child('links').child($pid).child(auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() >= 1 && (data.exists() ? newData.val() === data.val() : newData.val() <= root.child('meta').child('userCounter').val())"
        },
        "nickname": {
          ".write": "auth != null && root.child('links').child($pid).child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
        },
        "lang": {
          ".write": "auth != null && root.child('links').child($pid).child(auth.uid).exists()",
          ".validate": "newData.val() === 'ru' || newData.val() === 'en'"
        },
        "theme": {
          ".write": "auth != null && root.child('links').child($pid).child(auth.uid).exists()",
          ".validate": "newData.val() === 'system' || newData.val() === 'light' || newData.val() === 'dark'"
        },
        "admin": {
          ".write": "auth != null && !data.exists() && newData.val() === false && root.child('links').child($pid).child(auth.uid).exists()",
          ".validate": "newData.isBoolean()"
        },
        "$other": { ".validate": false }
      }
    },

    "supportSessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && root.child('players').child(newData.val()).child('admin').val() === true && root.child('links').child(newData.val()).child(auth.uid).exists()"
      }
    },

    "mossPosts": {
      ".read": true,
      "$id": {
        ".write": "auth != null && root.child('supportSessions').child(auth.uid).exists() && root.child('players').child(root.child('supportSessions').child(auth.uid).val()).child('admin').val() === true && root.child('links').child(root.child('supportSessions').child(auth.uid).val()).child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['title', 'text', 'author', 'createdAt'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8000"
        },
        "author": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)"
        },
        "updatedAt": {
          ".validate": "newData.val() === now"
        },
        "$other": { ".validate": false }
      }
    },

    "news": {
      ".read": true,
      "$id": {
        ".write": "auth != null && root.child('supportSessions').child(auth.uid).exists() && root.child('players').child(root.child('supportSessions').child(auth.uid).val()).child('admin').val() === true && root.child('links').child(root.child('supportSessions').child(auth.uid).val()).child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['title', 'text', 'author', 'createdAt'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 10000"
        },
        "author": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)"
        },
        "updatedAt": {
          ".validate": "newData.val() === now"
        },
        "$other": { ".validate": false }
      }
    },

    "newsComments": {
      ".read": true,
      "$post": {
        ".write": "(auth != null && root.child('supportSessions').child(auth.uid).exists() && root.child('players').child(root.child('supportSessions').child(auth.uid).val()).child('admin').val() === true && root.child('links').child(root.child('supportSessions').child(auth.uid).val()).child(auth.uid).exists()) && !newData.exists()",
        "$cid": {
          ".write": "auth != null && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && (auth != null && root.child('supportSessions').child(auth.uid).exists() && root.child('players').child(root.child('supportSessions').child(auth.uid).val()).child('admin').val() === true && root.child('links').child(root.child('supportSessions').child(auth.uid).val()).child(auth.uid).exists())))",
          ".validate": "newData.hasChildren(['text', 'name', 'role', 'createdAt'])",
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "role": {
            ".validate": "newData.val() === 'user' || (newData.val() === 'admin' && (auth != null && root.child('supportSessions').child(auth.uid).exists() && root.child('players').child(root.child('supportSessions').child(auth.uid).val()).child('admin').val() === true && root.child('links').child(root.child('supportSessions').child(auth.uid).val()).child(auth.uid).exists()))"
          },
          "parent": {
            ".validate": "newData.isString() && root.child('newsComments').child($post).child(newData.val()).exists() && !root.child('newsComments').child($post).child(newData.val()).child('parent').exists()"
          },
          "replyTo": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "createdAt": {
            ".validate": "newData.val() === now"
          },
          "$other": { ".validate": false }
        }
      }
    },

    "newsReactions": {
      ".read": true,
      "$post": {
        ".write": "(auth != null && root.child('supportSessions').child(auth.uid).exists() && root.child('players').child(root.child('supportSessions').child(auth.uid).val()).child('admin').val() === true && root.child('links').child(root.child('supportSessions').child(auth.uid).val()).child(auth.uid).exists()) && !newData.exists()",
        "$voter": {
          ".write": "auth != null",
          ".validate": "$voter.length === 32 && (newData.val() === 'like' || newData.val() === 'dislike')"
        }
      }
    },

    "reviewOwner": {
      "$key": {
        ".write": "auth != null && $key.length === 32 && ((!data.exists() && root.child('links').child(newData.val()).child(auth.uid).exists()) || (data.exists() && !newData.exists() && root.child('links').child(data.val()).child(auth.uid).exists()))",
        ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 128"
      }
    },

    "reviews": {
      ".read": true,
      "$key": {
        ".write": "auth != null && $key.length === 32 && ((newData.exists() && newData.parent().parent().child('reviewOwner').child($key).exists() && root.child('links').child(newData.parent().parent().child('reviewOwner').child($key).val()).child(auth.uid).exists()) || (!newData.exists() && ((root.child('reviewOwner').child($key).exists() && root.child('links').child(root.child('reviewOwner').child($key).val()).child(auth.uid).exists()) || (root.child('supportSessions').child(auth.uid).exists() && root.child('players').child(root.child('supportSessions').child(auth.uid).val()).child('admin').val() === true && root.child('links').child(root.child('supportSessions').child(auth.uid).val()).child(auth.uid).exists()))))",
        ".validate": "newData.hasChildren(['rating', 'name', 'createdAt'])",
        "rating": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5 && newData.val() % 1 === 0"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)"
        },
        "updatedAt": {
          ".validate": "newData.val() === now"
        },
        "$other": { ".validate": false }
      }
    },

    "chats": {
      "$pid": {
        ".read": "(auth != null && root.child('links').child($pid).child(auth.uid).exists()) || (auth != null && root.child('supportSessions').child(auth.uid).exists() && root.child('players').child(root.child('supportSessions').child(auth.uid).val()).child('admin').val() === true && root.child('links').child(root.child('supportSessions').child(auth.uid).val()).child(auth.uid).exists())",
        "$mid": {
          ".write": "!data.exists() && ((auth != null && root.child('links').child($pid).child(auth.uid).exists()) && newData.child('role').val() === 'user' || (auth != null && root.child('supportSessions').child(auth.uid).exists() && root.child('players').child(root.child('supportSessions').child(auth.uid).val()).child('admin').val() === true && root.child('links').child(root.child('supportSessions').child(auth.uid).val()).child(auth.uid).exists()) && newData.child('role').val() === 'admin')",
          ".validate": "newData.hasChildren(['role', 'name', 'text', 'createdAt'])",
          "role": {
            ".validate": "newData.val() === 'user' || newData.val() === 'admin'"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 2000"
          },
          "createdAt": {
            ".validate": "newData.val() === now"
          },
          "$other": { ".validate": false }
        }
      }
    },

    "chatList": {
      ".read": "auth != null && root.child('supportSessions').child(auth.uid).exists() && root.child('players').child(root.child('supportSessions').child(auth.uid).val()).child('admin').val() === true && root.child('links').child(root.child('supportSessions').child(auth.uid).val()).child(auth.uid).exists()",
      "$pid": {
        ".write": "(auth != null && root.child('links').child($pid).child(auth.uid).exists()) && newData.child('lastRole').val() === 'user' || (auth != null && root.child('supportSessions').child(auth.uid).exists() && root.child('players').child(root.child('supportSessions').child(auth.uid).val()).child('admin').val() === true && root.child('links').child(root.child('supportSessions').child(auth.uid).val()).child(auth.uid).exists()) && newData.child('lastRole').val() === 'admin'",
        ".validate": "newData.hasChildren(['nick', 'lastText', 'lastAt', 'lastRole'])",
        "nick": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "lastText": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
        },
        "lastAt": {
          ".validate": "newData.val() === now"
        },
        "lastRole": {
          ".validate": "newData.val() === 'user' || newData.val() === 'admin'"
        },
        "$other": { ".validate": false }
      }
    }
  }
}
